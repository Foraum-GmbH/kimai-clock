<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- nosemgrep: swift.insecure-communication.ats.ats-pinning.ATS-consider-pinning -- users connect to their own self-hosted Kimai servers, pinning is not possible -->
<plist version="1.0">
<dict>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- nosemgrep: swift.insecure-communication.ats.ats-load.ATS-arbitrary-loads -- required for self-hosted Kimai servers on plain HTTP -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kimai-clock</string>
			</array>
			<key>CFBundleURLName</key>
			<string>com.foraum.kimai-clock</string>
		</dict>
	</array>
</dict>
</plist>
